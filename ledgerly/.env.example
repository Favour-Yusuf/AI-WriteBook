# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored, so your keys never get committed.

# --- Supabase (needed from build step 2: authentication) ---------------------
# Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The address the app runs at; used in sign-up and password-reset emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- OpenAI (needed from build step 9: AI assistant) -------------------------
# Server-only. Never prefix with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=
